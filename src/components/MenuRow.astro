---
import { Image } from 'astro:assets';
import { loc, money, type Lang } from '../lib/i18n';
import { photo } from '../lib/images';
import { searchTextFor, type MenuItem } from '../lib/menu';

interface Props {
  item: MenuItem;
  lang: Lang;
}

const { item, lang } = Astro.props;
const name = loc(item.name, lang);
const desc = item.desc ? loc(item.desc, lang) : '';
const search = searchTextFor(item);
---

<li class="row" id={item.id} data-menu-item data-search={search}>
  <span class="row__thumb">
    {item.image && <Image src={photo(item.id)} alt="" width={96} height={96} format="webp" loading="lazy" />}
  </span>
  <span class="row__text">
    <span class="row__line">
      <span class="row__name">{name}</span>
      <span class="row__dots" aria-hidden="true"></span>
      <span class="row__price">{money(item.price, lang)}</span>
    </span>
    {desc && <span class="row__desc">{desc}</span>}
  </span>
</li>

<style>
  .row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.35rem;
    scroll-margin-top: calc(var(--header-h) + var(--tools-h) + 12px);
    border-radius: 12px;
  }
  .row:target {
    outline: 3px solid var(--pink);
    outline-offset: 2px;
  }
  .row__thumb {
    flex: none;
    width: 46px;
    height: 46px;
    overflow: hidden;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
  }
  .row__thumb:not(:has(img)) {
    background: none;
    border: 1.5px dashed rgb(255 255 255 / 0.35);
  }
  .row__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .row__text {
    flex: 1;
    min-width: 0;
    display: grid;
  }
  .row__line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .row__name {
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .row__dots {
    flex: 1;
    min-width: 1rem;
    border-bottom: 2px dotted rgb(255 255 255 / 0.32);
    translate: 0 -0.25em;
  }
  .row__price {
    font-weight: 700;
    white-space: nowrap;
  }
  .row__desc {
    color: rgb(255 255 255 / 0.78);
    font-size: 0.86rem;
    line-height: 1.35;
  }
</style>
