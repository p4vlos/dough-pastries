---
import { Image } from 'astro:assets';
import { loc, money, type Lang } from '../lib/i18n';
import { cutout, photo } from '../lib/images';
import { searchTextFor, type MenuItem } from '../lib/menu';
import { ui } from '../lib/ui';

interface Props {
  item: MenuItem;
  lang: Lang;
  dark?: boolean;
}

const { item, lang, dark = false } = Astro.props;
const name = loc(item.name, lang);
const desc = item.desc ? loc(item.desc, lang) : '';
const search = searchTextFor(item);
const cut = dark ? cutout(item.id) : undefined;
---

<li class:list={['card', { 'card--dark': dark }]} id={item.id} data-menu-item data-search={search}>
  <div class:list={['card__photo', { 'card__photo--cut': cut }]}>
    {
      cut ? (
        <Image src={cut} alt={name} widths={[200, 320, 440]} sizes="(min-width: 900px) 240px, 44vw" format="webp" loading="lazy" />
      ) : (
        <Image src={photo(item.id)} alt={name} widths={[320, 480, 640]} sizes="(min-width: 900px) 280px, 46vw" format="webp" loading="lazy" />
      )
    }
    {item.popular && <span class="card__badge">{ui[lang].menu.popular}</span>}
  </div>
  <div class="card__body">
    <h3 class="card__name">{name}</h3>
    {desc && <p class="card__desc">{desc}</p>}
    <p class="card__price">
      {money(item.price, lang)}
      {item.size && <span class="card__size">{item.size}</span>}
    </p>
  </div>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    color: var(--ink);
    scroll-margin-top: calc(var(--header-h) + var(--tools-h) + 12px);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 28px -18px rgb(97 39 23 / 0.5);
  }
  .card:target {
    outline: 3px solid var(--pink);
    outline-offset: 2px;
  }
  .card__photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__badge {
    position: absolute;
    left: 0.5rem;
    top: 0.5rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--pink);
    color: var(--ink);
    font-size: 0.74rem;
    font-weight: 700;
  }
  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.8rem 0.9rem 0.9rem;
  }
  .card__name {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
    text-wrap: pretty;
  }
  .card__desc {
    color: #5d4a3c;
    font-size: 0.86rem;
    line-height: 1.4;
  }
  .card__price {
    margin-top: auto;
    padding-top: 0.35rem;
    color: var(--caramel);
    font-size: 1.05rem;
    font-weight: 700;
  }
  .card__size {
    margin-left: 0.35rem;
    color: #5d4a3c;
    font-size: 0.82rem;
    font-weight: 600;
  }

  /* Cookies sit on black as cut-outs, with no card around them. */
  .card--dark {
    border: 0;
    background: none;
    color: #fff;
    text-align: center;
  }
  .card--dark:hover {
    transform: none;
    box-shadow: none;
  }
  .card__photo--cut {
    aspect-ratio: 1;
    overflow: visible;
  }
  .card__photo--cut :global(img) {
    object-fit: contain;
    transition: rotate 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.3), scale 0.35s ease;
  }
  .card--dark:hover :global(img) {
    rotate: 14deg;
    scale: 1.06;
  }
  .card--dark .card__desc {
    color: rgb(255 255 255 / 0.72);
  }
  .card--dark .card__price {
    color: var(--butter);
  }
  .card--dark .card__size {
    color: rgb(255 255 255 / 0.72);
  }
</style>
