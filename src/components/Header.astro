---
import Logo from './Logo.astro';
import site from '../data/site.json';
import { loc, pageUrl, type Lang, type PageId } from '../lib/i18n';
import { ui } from '../lib/ui';

interface Props {
  lang: Lang;
  page: PageId;
}

const { lang, page } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'el' : 'en';
const links: { id: PageId; label: string; short: string }[] = [
  { id: 'menu', label: t.nav.menu, short: t.nav.menu },
  { id: 'occasions', label: t.nav.occasions, short: t.nav.occasionsShort },
  { id: 'visit', label: t.nav.visit, short: t.nav.visitShort },
];
---

<header class="site-header">
  <div class="site-header__inner wrap">
    <a class="site-header__logo" href={pageUrl('home', lang)}>
      <Logo label={site.name} />
    </a>

    <nav class="site-nav" aria-label={t.nav.label}>
      {
        links.map(({ id, label, short }) => (
          <a href={pageUrl(id, lang)} aria-current={page === id ? 'page' : undefined} aria-label={label}>
            <span class="site-nav__long">{label}</span>
            <span class="site-nav__short">{short}</span>
          </a>
        ))
      }
    </nav>

    <div class="site-header__end">
      <a class="lang-switch" href={pageUrl(page, other)} hreflang={other} lang={other}>
        {other === 'el' ? 'ΕΛ' : 'EN'}
      </a>
      <a class="btn btn--primary btn--sm site-header__order" href={loc(site.links.wolt, lang)} rel="noopener">
        {t.actions.order}
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--ink);
    color: #fff;
    border-bottom: 1px solid rgb(255 217 133 / 0.18);
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    height: var(--header-h);
  }
  .site-header__logo {
    display: block;
    height: calc(var(--header-h) - 16px);
    aspect-ratio: 1160 / 716;
    border-radius: 8px;
  }
  /* The narrowest phones: the Greek labels only fit if everything tightens a little. */
  @media (max-width: 380px) {
    .site-header__inner {
      width: calc(100% - 1.5rem);
      gap: 0.5rem;
    }
    .site-header__logo {
      height: 34px;
    }
    .site-nav {
      gap: 0.5rem;
    }
    .site-nav a {
      font-size: clamp(0.8rem, 3.7vw, 0.98rem);
    }
    .lang-switch {
      width: 2rem;
      height: 2rem;
      font-size: 0.75rem;
    }
  }
  .site-nav {
    display: flex;
    justify-content: center;
    gap: clamp(0.65rem, 3vw, 2.25rem);
  }
  .site-nav a {
    position: relative;
    padding: 0.5rem 0.1rem;
    color: #fff;
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--butter);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .site-nav a[aria-current='page'] {
    color: var(--butter);
  }
  .site-nav__long {
    display: none;
  }
  .site-header__end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lang-switch {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1.5px solid rgb(255 217 133 / 0.45);
    border-radius: 50%;
    color: var(--butter);
    font-weight: 700;
    font-size: 0.82rem;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .lang-switch:hover {
    background: var(--butter);
    color: var(--ink);
  }
  .site-header__order {
    display: none;
  }

  @media (min-width: 900px) {
    .site-nav__long {
      display: inline;
    }
    .site-nav__short {
      display: none;
    }
    .site-header__order {
      display: inline-flex;
    }
  }
</style>
