---
import '@fontsource-variable/quicksand/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/sofia-sans-extra-condensed/wght.css';
import '@fontsource/pacifico/400.css';
import '@fontsource/mynerve/400.css';
import '../styles/global.css';

import ActionBar from '../components/ActionBar.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import site from '../data/site.json';
import { assetUrl, loc, pageUrl, type Lang, type PageId } from '../lib/i18n';
import { ui } from '../lib/ui';

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
  description: string;
}

const { lang, page, title, description } = Astro.props;
const t = ui[lang];
const absolute = (path: string) => new URL(path, Astro.site).href;

const schemaDays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: site.name,
  slogan: site.tagline,
  url: absolute(pageUrl('home', lang)),
  image: absolute(assetUrl('og.jpg')),
  telephone: site.phone.e164,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: loc(site.address.street, lang),
    addressLocality: loc(site.address.area, lang),
    addressRegion: loc(site.address.city, lang),
    postalCode: site.address.postcode,
    addressCountry: 'CY',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  sameAs: [site.links.facebook, site.links.instagram, site.links.wolt.en],
  openingHoursSpecification: Object.entries(site.hours).flatMap(([day, hours]) =>
    hours
      ? [{ '@type': 'OpeningHoursSpecification', dayOfWeek: schemaDays[Number(day)], opens: hours.open, closes: hours.close }]
      : [],
  ),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- A concept demo: keep it out of search results so it never competes with the real site. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#050708" />

    <link rel="icon" href={assetUrl('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={assetUrl('apple-touch-icon.png')} />
    <link rel="alternate" hreflang="en" href={absolute(pageUrl(page, 'en'))} />
    <link rel="alternate" hreflang="el" href={absolute(pageUrl(page, 'el'))} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(pageUrl(page, lang))} />
    <meta property="og:image" content={absolute(assetUrl('og.jpg'))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'el' ? 'el_GR' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <ActionBar lang={lang} />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
